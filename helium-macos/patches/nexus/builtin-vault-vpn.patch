+// Nexus: Nexus Vault and Proton VPN, built in the same way as uBlock Origin.
+void ComponentLoader::AddNexusBuiltins() {
+  static constexpr struct {
+    int manifest_resource_id;
+    const base::FilePath::CharType* root_directory;
+    const char* name;
+  } kNexusBuiltins[] = {
+      {IDR_NEXUS_BUILTIN_VAULT_MANIFEST_JSON,
+       FILE_PATH_LITERAL("nexus_builtin/vault"), "Nexus Vault"},
+      {IDR_NEXUS_BUILTIN_PROTON_VPN_MANIFEST_JSON,
+       FILE_PATH_LITERAL("nexus_builtin/proton_vpn"), "Proton VPN"},
+  };
+
+  for (const auto& builtin : kNexusBuiltins) {
+    if (Add(builtin.manifest_resource_id,
+            base::FilePath(builtin.root_directory))
+            .empty()) {
+      continue;  // not allowlisted or its manifest is invalid
+    }
+
+    using namespace extension_l10n_util;
+    ComponentExtensionInfo& info = component_extensions_.back();
+    std::string error;
+    if (!LocalizeExtension(info.root_directory, &info.manifest,
+                           GzippedMessagesPermission::kAllowForTrustedSource,
+                           &error, true)) {
+      LOG(ERROR) << "Failed to localize " << builtin.name << ": " << error;
+    }
+  }
+}
