diff --git a/third_party/nexus_builtin/BUILD.gn b/third_party/nexus_builtin/BUILD.gn
new file mode 100644
index 00000000..c0c3aecf
--- /dev/null
+++ b/third_party/nexus_builtin/BUILD.gn
@@ -0,0 +1,51 @@
+# Nexus: packs the built-in extensions (Nexus Vault, Proton VPN) into a pak,
+# the same way third_party/ublock packs uBlock Origin.
+
+import("//ui/webui/resources/tools/generate_grd.gni")
+import("//tools/grit/grit_rule.gni")
+
+file_list = "$target_gen_dir/files.json"
+generated_grd = "$target_gen_dir/nexus_builtin_resources.grd"
+
+action("generate_file_list") {
+  script = "generate_file_list.py"
+  args = [
+    rebase_path("."),
+    rebase_path(file_list),
+  ]
+  inputs = [
+    "generate_file_list.py",
+    "vault/manifest.json",
+    "proton_vpn/manifest.json",
+  ]
+  outputs = [ file_list ]
+}
+
+generate_grd("nexus_builtin_grd") {
+  out_grd = generated_grd
+
+  grd_prefix = "nexus_builtin"
+  resource_path_prefix = "nexus_builtin"
+
+  manifest_files = [ file_list ]
+  deps = [ ":generate_file_list" ]
+}
+
+grit("nexus_builtin") {
+  source = generated_grd
+
+  # Required because the .grd is generated.
+  enable_input_discovery_for_gn_analyze = false
+  use_brotli = true
+
+  output_dir = "$target_gen_dir/resources"
+
+  outputs = [
+    "grit/nexus_builtin_resources.h",
+    "grit/nexus_builtin_resources_map.cc",
+    "grit/nexus_builtin_resources_map.h",
+    "nexus_builtin_resources.pak",
+  ]
+
+  deps = [ ":nexus_builtin_grd" ]
+}
