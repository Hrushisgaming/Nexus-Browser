diff --git a/components/helium_services/nexus_extension_ids.h b/components/helium_services/nexus_extension_ids.h
new file mode 100644
index 00000000..a7a1a8dc
--- /dev/null
+++ b/components/helium_services/nexus_extension_ids.h
@@ -0,0 +1,37 @@
+// Nexus: ids of the extensions that are built into the browser as component
+// extensions (see third_party/nexus_builtin).
+
+#ifndef COMPONENTS_HELIUM_SERVICES_NEXUS_EXTENSION_IDS_H_
+#define COMPONENTS_HELIUM_SERVICES_NEXUS_EXTENSION_IDS_H_
+
+#include <string_view>
+
+namespace helium {
+
+// Nexus Vault. Fixed by the "key" in nexus-vault/manifest.json.
+inline constexpr char kNexusVaultComponentId[] =
+    "aideengppkjlkhmlfabkigdahhogfbdi";
+inline constexpr char kNexusVaultComponentIdHashed[] =
+    // SHA1(kNexusVaultComponentId)
+    "EDD4C0A0873E4902021EE8ED3586FFEFE75D3790";
+
+// Proton VPN. Same id as on the Chrome Web Store (the staging script adds the
+// store key to its manifest).
+inline constexpr char kNexusProtonVpnComponentId[] =
+    "jplgfhpmjnbigmhklmmbgecoobifkmpa";
+inline constexpr char kNexusProtonVpnComponentIdHashed[] =
+    // SHA1(kNexusProtonVpnComponentId)
+    "85AEFA346C73596D7164DC4A16DC7F38BD1A0A46";
+
+inline constexpr bool IsNexusBuiltinExtensionId(std::string_view id) {
+  return id == kNexusVaultComponentId || id == kNexusProtonVpnComponentId;
+}
+
+inline constexpr bool IsNexusBuiltinExtensionIdHashed(std::string_view hashed) {
+  return hashed == kNexusVaultComponentIdHashed ||
+         hashed == kNexusProtonVpnComponentIdHashed;
+}
+
+}  // namespace helium
+
+#endif  // COMPONENTS_HELIUM_SERVICES_NEXUS_EXTENSION_IDS_H_
