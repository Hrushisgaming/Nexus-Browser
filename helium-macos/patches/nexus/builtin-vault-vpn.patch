+Name: Nexus built-in extensions
+Short Name: nexus_builtin
+URL: https://github.com/imputnet/helium
+Version: 1
+License: GPL-3.0
+License File: LICENSE.txt
+Shipped: yes
+Security Critical: yes
+
+Description:
+Extensions that ship inside Nexus as component extensions (the same way
+third_party/ublock ships uBlock Origin): "vault" (Nexus Vault) and
+"proton_vpn" (Proton VPN). The extension folders are NOT part of the patch.
+They are copied in before the build by nexus_stage_builtin.py.
+
+Local Modifications:
+None to the extensions' code. The staging script only adds a "key" to Proton
+VPN's manifest so it keeps its Chrome Web Store id.
diff --git a/third_party/nexus_builtin/generate_file_list.py b/third_party/nexus_builtin/generate_file_list.py
new file mode 100644
index 00000000..5d5feed9
--- /dev/null
+++ b/third_party/nexus_builtin/generate_file_list.py
@@ -0,0 +1,40 @@
+# Nexus: lists every file of the built-in extensions in this folder
+# (vault/ and proton_vpn/) for grit. Same idea as third_party/ublock.
+#
+# usage: generate_file_list.py <src dir> <out json>
+
+import json
+import os
+import sys
+from fnmatch import fnmatchcase
+from pathlib import Path
+
+EXCLUDED_FILES = (
+    'BUILD.gn',
+    'README.chromium',
+    'generate_file_list.py',
+    '*/README.txt',
+    '*/.DS_Store',
+    '*/_metadata/*',
+)
+EXTENSION_DIRS = ('vault', 'proton_vpn')
+
+src = Path(sys.argv[1])
+out_file = sys.argv[2]
+files = []
+
+for ext in EXTENSION_DIRS:
+  ext_dir = src / ext
+  if not (ext_dir / 'manifest.json').is_file():
+    sys.exit('nexus_builtin: %s/manifest.json is missing. Run '
+             'nexus_stage_builtin.py before building.' % ext)
+  for root, _, filenames in os.walk(ext_dir):
+    for filename in filenames:
+      relative = (Path(root) / filename).relative_to(src).as_posix()
+      if any(fnmatchcase(relative, pattern) for pattern in EXCLUDED_FILES):
+        continue
+      files.append(relative)
+
+files.sort()
+with open(out_file, 'w') as f:
+  json.dump({'base_dir': src.as_posix(), 'files': files}, f)
