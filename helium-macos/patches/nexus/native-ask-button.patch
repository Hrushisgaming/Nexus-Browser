+// Nexus crosshair: ring, four ticks and an AI sparkle. Drawn as filled paths so it takes the theme's text color.
+
+CANVAS_DIMENSIONS, 24,
+FILL_RULE_NONZERO,
+// Outer ring (clockwise) with an inner circle cut out (counter-clockwise).
+MOVE_TO, 12, 1.5f,
+ARC_TO, 10.5f, 10.5f, 0, 1, 1, 12, 22.5f,
+ARC_TO, 10.5f, 10.5f, 0, 1, 1, 12, 1.5f,
+CLOSE,
+MOVE_TO, 12, 3.5f,
+ARC_TO, 8.5f, 8.5f, 0, 1, 0, 12, 20.5f,
+ARC_TO, 8.5f, 8.5f, 0, 1, 0, 12, 3.5f,
+CLOSE,
+// Four ticks pointing at the centre.
+MOVE_TO, 11, 1,
+R_H_LINE_TO, 2,
+R_V_LINE_TO, 6,
+R_H_LINE_TO, -2,
+CLOSE,
+MOVE_TO, 11, 17,
+R_H_LINE_TO, 2,
+R_V_LINE_TO, 6,
+R_H_LINE_TO, -2,
+CLOSE,
+MOVE_TO, 1, 11,
+R_H_LINE_TO, 6,
+R_V_LINE_TO, 2,
+R_H_LINE_TO, -6,
+CLOSE,
+MOVE_TO, 17, 11,
+R_H_LINE_TO, 6,
+R_V_LINE_TO, 2,
+R_H_LINE_TO, -6,
+CLOSE,
+// Sparkle in the middle.
+MOVE_TO, 12, 8,
+LINE_TO, 13.2f, 10.8f,
+LINE_TO, 16, 12,
+LINE_TO, 13.2f, 13.2f,
+LINE_TO, 12, 16,
+LINE_TO, 10.8f, 13.2f,
+LINE_TO, 8, 12,
+LINE_TO, 10.8f, 10.8f,
+CLOSE
